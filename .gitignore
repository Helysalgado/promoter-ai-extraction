# Same policy at the current on-disk location of the subset (constitution
# principle 9). Root-only so this does not match a tests/.../02-DOCS/data/ path.
/02-DOCS/data/

# Real gold workbook — redundant with /02-DOCS/data/, kept as an explicit
# exact rule so the historical evaluator path stays named in this file.
02-DOCS/data/SUBSET_GOLD.xlsx

